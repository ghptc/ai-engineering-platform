ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE=ai_engineering_platform
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
EXECUTION_SANDBOX_PROVIDER=Remote
EXECUTION_SANDBOX_ENDPOINT=
# LocalUnix is configured by backend/scripts/local-runtime.sh; no Docker socket mount.
EXECUTION_SANDBOX_SOCKET_PATH=/run/aep-executor/executor.sock
EXECUTION_SANDBOX_TOKEN=
APPLICATION_AUTH_MODE=Owner
# PBKDF2 SHA256: iterations:base64(salt):base64(hash). Generate with backend/scripts/owner-credential.py.
APPLICATION_OWNER_CREDENTIAL_SECRET=
EXECUTION_MAX_ITERATIONS=5
EXECUTION_MAX_TOOL_CALLS=30
EXECUTION_MAX_DURATION_MINUTES=60
EXECUTION_MAX_BUDGET_USD=5

LanguageModel__TimeoutSeconds=90
LanguageModel__MaxRetries=2

# Local job limits are capped again by the owner-managed daemon profiles.
SandboxExecution__TimeoutSeconds=120
SandboxExecution__MemoryMb=1024
SandboxExecution__CpuLimit=1
SandboxExecution__OutputLimitBytes=100000
